# Environment Variables - NEVER commit these!
assets/.env
.env
*.env
.env.local
.env.*.local
flutter_env.json

# Data drops — downloaded source files, never commit
zFDLEUpdate/*.csv
zFDLEUpdate/*.zip
zClerkDataUpdate/*.zip
zClerkDataUpdate/*.csv
zClerkDataUpdate/*.txt

# Build files
build/
*.iml
*.ipr
*.iws
.idea/
.vscode/*
!.vscode/launch.json
*.swp
*.swo
*~
.claude/

# OS files
.DS_Store
Thumbs.db

# Flutter/Dart
.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# Logs
*.log
logs/

# Temporary files
tempData/
temp_*/

# Ingest pipeline ephemera — raw source exports, parsed CSVs, generated SQL batches
ingest/*/work/

# Timestamped backups of stale env files (may contain dead credentials)
*.stale-*
assets/.env.stale-*
flutter_env.json.stale-*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Coverage
coverage/
*.coverage
